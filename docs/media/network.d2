# Agents in containers: what can reach what.
# Source for network.svg. Regenerate with `make diagrams`, which runs
# d2 --layout=tala over this file. Needs d2; nothing else in the tree does.
# See docs/dev/recommended-architecture.md sections 3 and 4.

direction: right

title: "Agents in containers -- reach" {
  shape: text
  near: top-center
  style: {
    font-size: 28
    bold: true
  }
}

host: "Host" {
  label.near: top-left
  style: {
    fill: "#f8f8f7"
    stroke: "#666666"
  }

  loopback: "loopback -- 127.0.0.1" {
    style: {
      fill: "#ffffff"
      stroke: "#999999"
    }

    tui: "minos TUI\ngo/cmd/minos" {
      style.fill: "#ffffff"
    }
    pma: "pma -- the tool\nadmin session" {
      style.fill: "#eef2f6"
    }
    broker1: "minosb -- run 1\nholds the grant" {
      style.fill: "#eef2f6"
    }
    broker2: "minosb -- run 2\nholds its own grant" {
      style.fill: "#eef2f6"
    }
  }

  minosd: "minosd" {
    label.near: top-left
    style: {
      fill: "#ffffff"
      stroke-width: 3
    }

    tcp: "one listener\ntcp 127.0.0.1:8000" {
      style.fill: "#eef2f6"
    }
    note: "no second listener.\nNo address on the\ncontainer network" {
      shape: text
      style.font-size: 16
    }
  }

  sock1: "/run/minos/run-1.sock\nmode 0600, agent uid\nmounted outside /work" {
    shape: page
    style.fill: "#ffffff"
  }
  sock2: "/run/minos/run-2.sock\none socket per run" {
    shape: page
    style.fill: "#ffffff"
  }

  relay: "sanduk relay\nHTTP/1.1, exact-path allowlist\nper-run bearer token, budget" {
    style: {
      fill: "#ffffff"
      stroke-width: 3
    }
  }

  sealed: "container network -- docker --internal\nno route off the host" {
    style: {
      fill: "#fbf9f5"
      stroke: "#666666"
      stroke-dash: 4
    }

    c1: "container 1 -- not root" {
      style.fill: "#ffffff"

      shim: "minosa\nopens the mounted file" {
        style.fill: "#eef2f6"
      }
      agent: "agent process\nno address of its own" {
        style: {
          fill: "#ffffff"
          stroke-dash: 2
        }
      }

      agent -> shim: "a command on PATH" {
        style.stroke: "#0f766e"
      }

      note: "no credential, no wire, no cursor.\nThe pipes leave as the container's stdio." {
        shape: text
        style.font-size: 16
      }
    }
    c2: "container 2 -- not root\nagent + minosa" {
      style.fill: "#ffffff"
    }
  }
}

provider: "model provider API\nhttps" {
  shape: cloud
  style.fill: "#ffffff"
}

host.loopback.tui -> host.minosd.tcp: "websocket + HTTP"
host.loopback.pma -> host.minosd.tcp: "admin ops:\nmint, revoke, found"
host.loopback.broker1 -> host.minosd.tcp: "its grant:\none room, windowed" {
  style: {
    stroke: "#0b3d63"
    stroke-width: 4
  }
}
host.loopback.broker2 -> host.minosd.tcp: "its own grant" {
  style: {
    stroke: "#0b3d63"
    stroke-width: 4
  }
}

host.sealed.c1.shim -> host.sock1: "six operations" {
  style: {
    stroke: "#0b3d63"
    stroke-width: 4
  }
}
host.sealed.c2 -> host.sock2: "six operations" {
  style: {
    stroke: "#0b3d63"
    stroke-width: 4
  }
}
host.sock1 -> host.loopback.broker1: "terminates at the broker,\nnot at minosd" {
  style: {
    stroke: "#0b3d63"
    stroke-width: 4
  }
}
host.sock2 -> host.loopback.broker2 {
  style: {
    stroke: "#0b3d63"
    stroke-width: 4
  }
}

host.sealed.c1.agent -> host.relay: "completions only" {
  style: {
    stroke: "#7a7a7a"
    stroke-dash: 2
    stroke-width: 3
  }
}
host.relay -> provider: "the only egress\nfrom a sealed container" {
  style: {
    stroke: "#7a7a7a"
    stroke-dash: 2
    stroke-width: 3
  }
}

host.sealed.c1 -> host.minosd.tcp: "no route:\nminosd has no address here" {
  style: {
    stroke: "#aa3333"
    stroke-dash: 4
  }
}
host.sealed.c1 -> host.sealed.c2: "reachable, and nothing listens:\nneither container runs a server" {
  style: {
    stroke: "#aa3333"
    stroke-dash: 4
  }
}
host.sealed.c1.shim -> host.sock2: "another run's socket\nis not mounted here" {
  style: {
    stroke: "#aa3333"
    stroke-dash: 4
  }
}

legend: "navy, heavy: the one path a container has, and where it stops\ngrey dotted: model traffic, through the relay\nred dashed: no route, or nothing to reach\nThe mount removes reach. The grant, held outside, removes authority.\nThe six operations remove the rest: minosd's file and settings routes are not implemented here." {
  shape: text
  near: bottom-center
  style.font-size: 18
}
