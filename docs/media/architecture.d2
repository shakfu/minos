# Agents in containers: who talks to whom.
# Source for architecture.svg. Regenerate with `make diagrams`, which runs
# d2 --layout=tala over this file. Needs d2; nothing else in the tree does.
# See docs/dev/recommended-architecture.md

direction: down

title: "Agents in containers -- architecture" {
  shape: text
  near: top-center
  style: {
    font-size: 28
    bold: true
  }
}

host: "Host" {
  style: {
    fill: "#f8f8f7"
    stroke: "#666666"
  }

  dev: "Developer" {
    shape: person
    style.fill: "#ffffff"
  }

  tui: "minos TUI\ngo/cmd/minos" {
    style.fill: "#ffffff"
  }

  pma: "pma -- the tool\ntrusted: it is code\nadmin session" {
    style: {
      fill: "#eef2f6"
      stroke-width: 3
    }
  }

  supervisor: "pma-agent\nuntrusted model\nholds a grant" {
    style: {
      fill: "#ffffff"
      stroke-dash: 2
    }
  }

  broker: "minosb -- the broker" {
    style: {
      fill: "#ffffff"
      stroke-width: 3
    }

    note: "one per run.\nHolds the grant, the cursor and the pipes" {
      shape: text
      style.font-size: 16
    }

    wire: "wire side\ngrant, 6 ops, one queue, one cursor" {
      style.fill: "#eef2f6"
    }
    sockd: "socket server\nsix operations, and no seventh" {
      style.fill: "#eef2f6"
    }
    pipes: "process side\nruns the stage through sanduk,\nstream-json in and out" {
      style.fill: "#eef2f6"
    }

    wire -> sockd: "drains the queue\nwhen the agent asks" {
      style.stroke: "#0f766e"
    }
    sockd -> wire: "say, submit,\nawait, progress" {
      style.stroke: "#0f766e"
    }
    wire -> pipes: "pushes what\nwill not wait" {
      style.stroke: "#0f766e"
    }
    pipes -> wire: "relays the turn's\nfinal message" {
      style.stroke: "#0f766e"
    }
  }

  sanduk: "sanduk\nbuilds, starts and kills the container\nowns the per-agent adapter" {
    style.fill: "#ffffff"
  }

  minosd: "minosd" {
    style: {
      fill: "#ffffff"
      stroke-width: 3
    }

    core: "one listener\nsocket + chat + timeline" {
      style.fill: "#eef2f6"
    }
    control: "control\nchannel, restricted to group workers\nread-only to its audience" {
      style.fill: "#ffffff"
    }
    room: "workflow/<id>\nroom, admin-founded\none per workflow instance" {
      style.fill: "#ffffff"
    }

    core -> control
    core -> room
  }
}

box: "Sealed container -- one per run\nno credential, no wire, no address" {
  style: {
    fill: "#fbf9f5"
    stroke: "#666666"
    stroke-dash: 4
  }

  agent: "agent process\nclaude, or another CLI" {
    style: {
      fill: "#ffffff"
      stroke-dash: 2
    }
  }

  shim: "minosa -- multicall shim on PATH\nmessages, say, submit,\nawait, progress, status\n(and `minosa mcp`, later)" {
    style.fill: "#ffffff"
  }

  agent -> shim: "runs a command;\nnever learns it is remote" {
    style.stroke: "#0f766e"
  }
}

mounts: "bind mounts\n/work at its host path, artifacts, session store" {
  shape: cylinder
  style.fill: "#ffffff"
}

host.dev -> host.tui
host.tui -> host.minosd.core: "chat"
host.supervisor -> host.minosd.core: "chat, within its grant"
host.pma -> host.minosd.core: "admin: found rooms, invite,\nmint and revoke grants" {
  style: {
    stroke: "#0b3d63"
    stroke-width: 4
  }
}
host.pma -> host.broker: "dispatch a stage:\nthe grant, the room, the window" {
  style: {
    stroke: "#0b3d63"
    stroke-width: 4
  }
}
host.broker.wire -> host.minosd.core: "the grant, on the ordinary listener.\nThe room gets every turn's final message" {
  style: {
    stroke: "#0b3d63"
    stroke-width: 4
  }
}
box.shim -> host.broker.sockd: "unix socket, one per run,\nmounted outside /work.\nThe socket is the credential" {
  style: {
    stroke: "#0b3d63"
    stroke-width: 4
  }
}

host.broker.pipes -> host.sanduk: "run the stage,\nstdio on pipes" {
  style: {
    stroke: "#7a7a7a"
    stroke-dash: 4
  }
}
host.sanduk -> box: "builds, starts, kills.\nMaps the host uid; the agent is not root" {
  style: {
    stroke: "#7a7a7a"
    stroke-dash: 4
  }
}
host.pma -> box: "stops it directly:\nneeds neither minosd nor the broker" {
  style: {
    stroke: "#7a7a7a"
    stroke-dash: 4
  }
}

host.broker.pipes -> box.agent: "stdin: a pushed message,\nqueued for the turn's end;\nan interrupt, which is not" {
  style.stroke: "#0f766e"
}
box.agent -> host.broker.pipes: "stdout: the turn,\nits trace, its cost" {
  style.stroke: "#0f766e"
}

box.agent -> mounts: "writes artifacts" {
  style: {
    stroke: "#9a9a9a"
    stroke-dash: 2
  }
}
host.pma -> mounts: "reads artifacts" {
  style: {
    stroke: "#9a9a9a"
    stroke-dash: 2
  }
}

legend: "blue: conversation, through minos\nnavy, heavy: authority -- grants, dispatch, and the one path a container has\nteal: the three lanes -- the agent asks, the broker pushes and reads\ngrey dashed: container control, never through minos\ngrey dotted: files, on the bind mount, never through minos\nThe container implements nothing. What it cannot ask for, the broker does not have." {
  shape: text
  near: bottom-center
  style.font-size: 18
}
