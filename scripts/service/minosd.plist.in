<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- minosd as a launchd user agent. `make install-service` fills @BINDIR@ and @STATE@. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>net.minos.minosd</string>
	<key>ProgramArguments</key>
	<array>
		<string>@BINDIR@/minosd</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@STATE@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>MINOS_RUN</key>
		<string>@STATE@/.run</string>
		<key>MINOS_VFS</key>
		<string>@STATE@/vfs</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@STATE@/minosd.log</string>
	<key>StandardErrorPath</key>
	<string>@STATE@/minosd.log</string>
</dict>
</plist>
